# Corridor - environment.
#
# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env* is gitignored. These two values also have to be set in the Vercel
# project, or the deployed build will fall back to the static artefact and the
# localStorage gate.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe in client code: it grants nothing on its
# own, because every table is RLS-enabled and every policy tests auth.uid().
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT USED BY THE APP, and never commit it. The service-role key bypasses RLS
# entirely. If you seed from a script rather than the SQL editor, pass it as a
# shell variable for that one command and do not write it to a file.
# SUPABASE_SERVICE_ROLE_KEY=
